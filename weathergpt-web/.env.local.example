# weathergpt-web — Next.js environment variables
# Copy this file to .env.local and fill in your project details.
# NEVER commit .env.local to version control.

# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI origin used by lib/api/chat.ts
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The backend (backend/.env) uses the SAME Supabase values under names WITHOUT the
# NEXT_PUBLIC_ prefix: SUPABASE_URL, SUPABASE_ANON_KEY. See the root .env.example for
# every backend variable. Never put SUPABASE_SERVICE_ROLE_KEY, VAPID_PRIVATE_KEY or
# ALERT_JOB_TOKEN in this file.

# ─── Backend LLM (not read by Next.js; set these on the FastAPI process) ───
# Names match backend/llm/provider.py exactly. Leave empty unless you run the API here.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=
# LLM_API_KEY=
