# WeatherGPT — Environment Variables
# Copy values into a local env file. NEVER commit actual credentials.

# ─── Frontend (Next.js) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── Backend LLM (backend/llm/provider.py) ───
# Optional. If unset, /api/chat uses the deterministic parser and templates.
# LLM_PROVIDER = gemini | groq | openai | none
LLM_PROVIDER=
# Provider-specific keys (first match wins if LLM_PROVIDER is unset):
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional overrides:
LLM_MODEL=
LLM_API_KEY=

# ─── Backend trusted default location (backend/auth/trusted_location.py) ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
