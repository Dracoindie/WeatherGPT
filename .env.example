# WeatherGPT: environment variables (template only; NEVER commit real values)
#
# There are TWO env files, one per process:
#   frontend  ->  weathergpt-web/.env.local   (Next.js; see weathergpt-web/.env.local.example)
#   backend   ->  backend/.env                (FastAPI, loaded with python-dotenv; real env vars win)
#
# IMPORTANT: the backend uses names WITHOUT the NEXT_PUBLIC_ prefix.
#   frontend: NEXT_PUBLIC_SUPABASE_URL       backend: SUPABASE_URL
#   frontend: NEXT_PUBLIC_SUPABASE_ANON_KEY  backend: SUPABASE_ANON_KEY
# The backend does NOT read NEXT_PUBLIC_* names. If it finds only the prefixed
# ones it logs a warning at startup (and in the alert job) telling you to rename them.
#
# Anything marked BACKEND ONLY is a secret: never put it in a NEXT_PUBLIC_* variable,
# never put it in weathergpt-web/.env.local, never commit it.

# ════════════════════════════════════════════════════════════════════════════
# FRONTEND  (weathergpt-web/.env.local)
# ════════════════════════════════════════════════════════════════════════════
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI origin
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ════════════════════════════════════════════════════════════════════════════
# BACKEND  (backend/.env)
# ════════════════════════════════════════════════════════════════════════════

# ─── CORS ───
# Comma-separated browser origins allowed to call the API.
# Default when empty: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=

# ─── Supabase (same project as the frontend; names WITHOUT NEXT_PUBLIC_) ───
# Used for the trusted default location (auth/trusted_location.py) and the
# signed-in "Send test alert" endpoint.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# BACKEND ONLY. Bypasses RLS; used only by the alert job (dissemination/store.py).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Web Push (docs/EARLY_WARNING.md, step 2 shows how to generate keys) ───
# Public key: safe to share; served to browsers by GET /api/push/config.
VAPID_PUBLIC_KEY=
# BACKEND ONLY.
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services
VAPID_SUBJECT=mailto:ops@example.org
# BACKEND ONLY. Long random string guarding POST /api/alerts/check (X-Job-Token header).
ALERT_JOB_TOKEN=

# ─── LLM (optional; backend/llm/provider.py) ───
# If unset, /api/chat uses the deterministic parser and templates.
# Any LLM output is only accepted if every number passes the grounding check.
# LLM_PROVIDER = gemini | groq | openai | none
LLM_PROVIDER=
# Provider-specific keys (first match wins if LLM_PROVIDER is unset). BACKEND ONLY.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional overrides
LLM_MODEL=
LLM_API_KEY=
